{# read and display all flash messages #}

{# {% block  %} #}
<twig:Turbo:Frame id="the_frame_id" action='append'>
    <a href="{{ path('app_order') }}">Home</a>
</twig:Turbo:Frame>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-{{ label }}">
            {{ message|trans|raw }}
        </div>
    {% endfor %}
{% endfor %}
<br>
<turbo-frame  id="form" src="path('app_order')">
    {{ form(form) }}
</turbo-frame>