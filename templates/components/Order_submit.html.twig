

{% extends 'base.html.twig' %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('styles/order_form.css')}}" />
{% endblock %}

{% block javascripts %}
    <script src="{{asset('scripts/order_form.js')}}"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@latest/dist/turbo.es2017-esm.min.js"></script>
{% endblock %}

{% block title %} Kantine {% endblock %}

{% block content %}
    {# <turbo-frame id="the_frame_id">
        <a href="{{ path('app_order') }}">This block is scoped, the rest of the page will not change if you click here!</a>
    </turbo-frame> #}
    {# we only want to show one message, dont add more then one flashes #}
    {% for label, messages in app.flashes %}
        {{messages|join}}
    {% endfor %}
    {# {% block message_stream %}
    <twig:Turbo:Frame id="message_stream" src="{{ path('submit_order') }}">
        {% for label, messages in app.flashes|slice(0,1) %}
            {% for message in messages %}
                <twig:Turbo:Stream:Replace target="#messages">
                    Content to prepend to container designated with the dom_id.
                </twig:Turbo:Stream:Replace>
                <twig:Alert type="{{label}}" message="{{message|trans}}" /> 



                <turbo-stream action="Append" targets="#messages">
                    <template>
                        The element having the id "my_div_id" will be replaced by this block, without a full page reload!
                        <twig:Alert type="{{label}}" message="{{message|trans}}" /> 
                        <div>The task "test" has been created!</div>
                    </template>
                </turbo-stream>

                
            {% endfor %}
        {% endfor %}
    </twig:Turbo:Frame>
    {% endblock %} #}

    <twig:Turbo:Frame id="form" src="{{path('app_order')}}">
    {# 
        TODO: manually writing out how the form should be displayed should probably be done via form_themes:
        https://symfony.com/doc/current/form/form_themes.html#create-your-own-form-theme
    #}
    {# <turbo-frame  id="form" src="path('app_order')"> #}
    {# <twig:Turbo:Stream:Replace target="#message_stream">
        appended
    </twig:Turbo:Stream:Replace> #}


    {{ form_start(form) }}
        
        <div class="my-custom-class-for-errors">
            {{ form_errors(form) }}
        </div>
        <label class="Costumer-label"> 
            {{ form.Costumer.vars.label }}
            {{ form_widget(form.Costumer, {'attr': {'autofocus': true, class: 'costumer-input'}}) }}
        </label>


        <div id="menus" class="menus">
        {% for choice in form.ordered_item.vars.choices %}
            {% if loop.index%2 == 0 %}{% endif %}
            
            <label class="menulabel btn" for="{{ form.ordered_item.vars.name }}_{{ choice.value }}">
                {{ choice.label|trans }}
                <input 
                    class="input_invis" 
                    type="radio" 
                    id="{{ form.ordered_item.vars.name }}_{{ choice.value }}" 
                    name="order_dto[{{ form.ordered_item.vars.name }}]" 
                    value="{{ choice.value }}"
                    {# surely there is a better way to check wether this is selected #}
                    checked="{{ form.tax.vars.value == choice.value }}"
                    
                    />
            </label>
            {% do form.ordered_item.setRendered() %}
            
        {% endfor %}
        </div>
        
        
        <div class="footer">
        {{ form_widget(form.tax, {'attr': {'checked':'', 'type':'hidden'}}) }}
            {# <input
                type="hidden"
                id="{{ form.tax.vars.name }}_{{ choice.value }}" 
                name="order_dto[{{ form.tax.vars.name }}]" 
                value="{{ choice.value }}"
                class="input_invis" 
                
                {% if form.tax.vars.value == choice.value %}
                    checked
                {% endif %}
                />
            {% do form.tax.setRendered() %} #}

            <label class="btn submit">
                <!-- Submit Button -->
                OK
                {{ form_widget(form.save,  {'attr': {'style':"display: none"}}) }}
            </label>

            {# if the user already ordered, display the update and cancel buttons, else just say that they are rendered, so symphony doesnt automatically render it #}
            {% if override_form %}
                <link rel="stylesheet" href="{{asset('styles/popUp.css')}}" />
                <div class="popup-overlay alert">
                    <div class="popup-box">
                        <p id="popup-message">{{"User already ordered, update order?"|trans}}</p>
                        <div class="popup-buttons">
                                {{ form_widget(form.update) }}
                                {{ form_widget(form.cancel) }}
                        </div>
                    </div>
                    
                </div>
            {% else %}
                {% do form.update.setRendered %}
                {% do form.cancel.setRendered %}
            {% endif %}
        </div>

    {{ form_end(form) }}

    </twig:Turbo:Frame>
{% endblock %}